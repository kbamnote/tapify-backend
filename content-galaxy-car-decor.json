        {
          "id": "about-1",
          "type": "about",
          "visible": true,
          "variant": "image-right",
          "props": {
            "label": "About Us",
            "heading": "A car accessories shop that also fits",
            "body": "Galaxy Car Decor is a car accessories and decor shop in Nagpur. We stock the full range — interior, audio, lighting, exterior styling and detailing — and we fit all of it ourselves.\n\nThat matters more than it sounds. Most accessory problems are fitting problems, not product problems: a player that loses power, damping that rattles after a month, ambient strips that come unstuck in summer, a reverse camera aimed at the bumper. Doing our own fitting is how we stay answerable for it.\n\nBring the car in and tell us the budget. We will tell you what is worth doing on your model, what genuinely is not, and what it costs before we start.",
            "image": "https://images.pexels.com/photos/20051458/pexels-photo-20051458.jpeg?auto=compress&cs=tinysrgb&w=1200",
            "showPillars": true,
            "pillars": [
              {
                "icon": "tool",
                "title": "Fitted here, by us",
                "text": "Not a counter sale. Everything we sell is fitted and tested in our shop before you drive out."
              },
              {
                "icon": "car",
                "title": "All makes and models",
                "text": "Hatchback, sedan, SUV — we will tell you honestly what fits your car and what does not."
              },
              {
                "icon": "tag",
                "title": "Price before we start",
                "text": "You hear the full figure first, fitting included. No surprises when you come to collect."
              }
            ]
          }
        },
